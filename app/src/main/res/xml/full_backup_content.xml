<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include
        domain="sharedpref"
        path="." />
    <include
        domain="database"
        path="." />
    <include
        domain="file"
        path="imported" />
    <include
        domain="file"
        path="pending" />
    <include
        domain="file"
        path="clash/override.json" />
    <!-- WebDAV 同步凭证仅存本机,排除出自动备份 -->
    <exclude
        domain="sharedpref"
        path="sync.xml" />
</full-backup-content>